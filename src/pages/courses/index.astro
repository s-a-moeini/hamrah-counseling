
---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const courses = (await getCollection('courses')).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
);

const getImageUrl = (image?: string) => {
  if (!image) return '';

  if (image.startsWith('http://') || image.startsWith('https://')) {
    return image;
  }

  return `${base.replace(/\/?$/, '/')}${image.replace(/^\/+/, '')}`;
};
---

<MainLayout
  title="دوره‌های آموزشی | مرکز مشاوره تخصصی همراه"
  description="فهرست دوره‌ها و کارگاه‌های آموزشی مرکز مشاوره تخصصی همراه"
>
  <section class="courses-page">
    <div class="container">
      <header class="page-header">
        <span class="eyebrow">آموزش و یادگیری</span>
        <h1>دوره‌های آموزشی</h1>
        <p>برای مشاهده جزئیات هر دوره، روی آن کلیک کنید.</p>
      </header>

      {courses.length > 0 ? (
        <div class="courses-list">
          {courses.map((course) => (
            <button
              type="button"
              class="course-card"
              data-name={course.data.name}
              data-image={getImageUrl(course.data.image)}
              data-instructor={course.data.instructor}
              data-instructor-bio={course.data.instructorBio}
              data-topics={course.data.topics}
              data-location={course.data.location}
              data-schedule={course.data.schedule}
              data-duration={course.data.duration}
              data-description={course.data.description}
              data-cost={course.data.cost}
              data-registration={course.data.registration}
            >
              <div class="course-image">
                {course.data.image ? (
                  <img
                    src={getImageUrl(course.data.image)}
                    alt={course.data.name}
                    loading="lazy"
                  />
                ) : (
                  <div class="image-placeholder">دوره آموزشی</div>
                )}
              </div>

              <div class="course-content">
                <h2>{course.data.name}</h2>

                <div class="course-topics">
                  <strong>توضیحات:</strong>
                  <p>{course.data.description}</p>
                </div>

                <div class="course-meta">
                  <span>
                    <strong>تاریخ:</strong>
                    {course.data.schedule}
                  </span>
                  <span>
                    <strong>مکان:</strong>
                    {course.data.location}
                  </span>
                </div>

                <span class="more-link">مشاهده جزئیات دوره ←</span>
              </div>
            </button>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>در حال حاضر دوره‌ای ثبت نشده است.</h2>
          <p>به‌زودی دوره‌های آموزشی جدید در این بخش قرار می‌گیرند.</p>
        </div>
      )}
    </div>
  </section>

  <dialog id="course-modal" class="course-modal">
    <div class="modal-content">
      <button type="button" class="modal-close" aria-label="بستن">×</button>

      <img id="modal-image" class="modal-image" alt="" />

      <div class="modal-body">
        <h2 id="modal-name"></h2>

        <div class="modal-section">
          <h3>مدرس دوره</h3>
          <p id="modal-instructor"></p>
          <p id="modal-instructor-bio"></p>
        </div>

        <div class="modal-section">
          <h3>سرفصل‌ها</h3>
          <p id="modal-topics"></p>
        </div>

        <div class="modal-section">
          <h3>تاریخ و مکان برگزاری</h3>
          <p id="modal-schedule"></p>
          <p id="modal-location"></p>
        </div>

        <div class="modal-section">
          <h3>مدت برگزاری</h3>
          <p id="modal-duration"></p>
        </div>

        <div class="modal-section">
          <h3>توضیحات دوره</h3>
          <p id="modal-description"></p>
        </div>

        <div class="modal-section">
          <h3>هزینه</h3>
          <p id="modal-cost"></p>
        </div>

        <div class="modal-section">
          <h3>نحوه ثبت‌نام</h3>
          <p id="modal-registration"></p>
        </div>
      </div>
    </div>
  </dialog>
</MainLayout>

<style>
  .courses-page {
    padding: 70px 0 100px;
    min-height: 60vh;
  }

  .container {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .eyebrow {
    color: #168b80;
    font-size: 14px;
  }

  .page-header h1 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 12px 0;
    color: #173d3a;
  }

  .page-header p {
    color: #64716f;
  }

  .courses-list {
    display: grid;
    gap: 20px;
  }

  .course-card {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 24px;
    width: 100%;
    padding: 20px;
    text-align: right;
    font: inherit;
    color: inherit;
    background: #fff;
    border: 1px solid #e5eeeb;
    border-radius: 18px;
    cursor: pointer;
    transition: .2s ease;
  }

  .course-card:hover {
    border-color: #168b80;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px #173d3a12;
  }

  .course-image {
    height: 190px;
    overflow: hidden;
    border-radius: 12px;
    background: #edf5f2;
  }

  .course-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    color: #168b80;
  }

  .course-content h2 {
    margin: 0 0 15px;
    font-size: 21px;
    color: #173d3a;
  }

  .course-topics {
    margin-bottom: 15px;
  }

  .course-topics p {
    white-space: pre-line;
    margin: 7px 0;
    color: #64716f;
    line-height: 1.9;
  }

  .course-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 25px;
    color: #64716f;
    font-size: 14px;
  }

  .course-meta strong {
    color: #173d3a;
    margin-left: 5px;
  }

  .more-link {
    display: inline-block;
    margin-top: 18px;
    color: #168b80;
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    background: #f3f8f6;
    border-radius: 18px;
  }

  .course-modal {
    width: min(650px, calc(100% - 30px));
    max-height: 85vh;
    padding: 0;
    border: 0;
    border-radius: 18px;
    color: #263b38;
    background: white;
  }

  .course-modal::backdrop {
    background: #102b29aa;
    backdrop-filter: blur(3px);
  }

  .modal-content {
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: white;
    color: #173d3a;
    font-size: 27px;
    cursor: pointer;
  }

  .modal-image {
    display: none;
    width: 100%;
    max-height: 280px;
    object-fit: cover;
  }

  .modal-image.visible {
    display: block;
  }

  .modal-body {
    padding: 25px;
  }

  .modal-body h2 {
    margin: 0 0 25px;
    color: #168b80;
    font-size: 25px;
  }

  .modal-section {
    padding: 15px 0;
    border-bottom: 1px solid #e8efed;
  }

  .modal-section:last-child {
    border-bottom: 0;
  }

  .modal-section h3 {
    margin: 0 0 10px;
    font-size: 16px;
    color: #173d3a;
  }

  .modal-section p {
    margin: 5px 0;
    line-height: 2;
    white-space: pre-line;
    color: #64716f;
  }

  @media (max-width: 650px) {
    .course-card {
      grid-template-columns: 1fr;
      gap: 15px;
      padding: 14px;
    }

    .course-image {
      height: 190px;
    }

    .modal-body {
      padding: 20px;
    }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#course-modal');

  const fields = [
    'name',
    'instructor',
    'instructor-bio',
    'topics',
    'schedule',
    'location',
    'duration',
    'description',
    'cost',
    'registration',
  ];

  document.querySelectorAll<HTMLButtonElement>('.course-card').forEach((card) => {
    card.addEventListener('click', () => {
      if (!modal) return;

      fields.forEach((field) => {
        const element = document.getElementById(`modal-${field}`);
        const value = card.dataset[field] || '';

        if (element) {
          element.textContent = value;
          const section = element.closest('.modal-section');
          if (section) {
            section.hidden = !value.trim();
          }
        }
      });

      const image = document.querySelector<HTMLImageElement>('#modal-image');
      const imageUrl = card.dataset.image || '';

      if (image) {
        image.src = imageUrl;
        image.alt = card.dataset.name || '';
        image.classList.toggle('visible', Boolean(imageUrl));
      }

      modal.showModal();
    });
  });

  document.querySelector('.modal-close')?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) {
      modal.close();
    }
  });
</script>
