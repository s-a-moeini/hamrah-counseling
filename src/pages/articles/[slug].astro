
---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL;

const getImageUrl = (image?: string) => {
  if (!image) return '';

  if (image.startsWith('http://') || image.startsWith('https://')) {
    return image;
  }

  return `${base.replace(/\/?$/, '/')}${image.replace(/^\/+/, '')}`;
};
---

<MainLayout
  title={`${article.data.title} | مرکز مشاوره تخصصی همراه`}
  description={article.data.summary}
>
  <main class="article-page">
    <article class="article-container">
      <a class="back-link" href={`${base.replace(/\/?$/, '/')}articles/`}>
        ← بازگشت به مقالات
      </a>

      <header class="article-header">
        <span class="eyebrow">مقالات آموزشی</span>
        <h1>{article.data.title}</h1>
        <p class="article-summary">{article.data.summary}</p>
      </header>

      {article.data.image && (
        <div class="article-image">
          <img
            src={getImageUrl(article.data.image)}
            alt={article.data.title}
          />
        </div>
      )}

      <div class="article-content">
        <p>{article.data.content}</p>
      </div>
    </article>
  </main>
</MainLayout>

<style>
  .article-page {
    min-height: 70vh;
    padding: 55px 20px 100px;
  }

  .article-container {
    width: min(850px, 100%);
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 35px;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .article-header {
    margin-bottom: 35px;
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 700;
  }

  .article-header h1 {
    margin: 15px 0;
    color: var(--color-primary-dark);
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.8;
  }

  .article-summary {
    color: var(--color-muted);
    font-size: 16px;
    line-height: 2.2;
  }

  .article-image {
    margin-bottom: 40px;
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-background);
  }

  .article-image img {
    display: block;
    width: 100%;
    max-height: 450px;
    object-fit: cover;
  }

  .article-content {
    color: var(--color-text);
    font-size: 16px;
    line-height: 2.5;
  }

  .article-content p {
    margin: 0;
    white-space: pre-line;
  }
</style>
