---

const base = import.meta.env.BASE_URL;

//const phones = [
// '03132677465',
//  '03132677417',
//  '09133395161',
//];

const phones = [
  '۰۳۱۳۲۶۷۷۴۶۵',
  '۰۳۱۳۲۶۷۷۴۱۷',
  '۰۹۱۳۳۳۹۵۱۶۱',
];
---

<section class="contact-section" id="contact">
  <div class="container">
    <div class="section-heading">
      <span>ارتباط با ما</span>
      <h2>همراه شما هستیم</h2>
      <p>
        برای دریافت اطلاعات بیشتر یا هماهنگی جلسات مشاوره،
        می‌توانید با مرکز تماس بگیرید یا به آدرس ما مراجعه کنید.
      </p>
    </div>

    <div class="contact-grid">
      <div class="contact-info">
        <div class="contact-item">
          <div class="contact-icon">⌖</div>
          <div>
            <h3>آدرس مرکز</h3>
            <p>
              اصفهان، خیابان بزرگمهر، خیابان هشت بهشت شرقی،
              نرسیده به چهارراه لاهور، ساختمان سپاهان،
              طبقه ۳، واحد ۶
            </p>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon">☎</div>
          <div>
            <h3>شماره‌های تماس</h3>
            <div class="phone-list">
              {phones.map((phone) => (
                <a href={`tel:${phone}`} dir="ltr">{phone}</a>
              ))}
            </div>
          </div>
        </div>

        <a
          class="map-link"
          href="https://www.google.com/maps/search/?api=1&query=ساختمان+سپاهان+هشت+بهشت+شرقی+اصفهان"
          target="_blank"
          rel="noopener noreferrer"
        >
          مشاهده موقعیت در نقشه
          <span>←</span>
        </a>
      </div>

      <div class="contact-visual">
        <div class="visual-content">
          <!--<span class="visual-icon">✦</span>-->
          <img
            src={`${base}/images/logo/logo.webp`}
            alt="لوگوی مرکز مشاوره تخصصی همراه"
            class="contact-logo-image"
          />
          <h3>مرکز مشاوره تخصصی همراه</h3>
          <p>همراه شما در مسیر آرامش و رشد</p>
          <div class="visual-line"></div>
          <span class="supervision">
            تحت نظارت اداره کل بهزیستی استان اصفهان
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 100px 0;
    background: var(--color-background);
  }

  .section-heading {
    max-width: 650px;
    margin: 0 auto 45px;
    text-align: center;
  }

  .section-heading > span {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 700;
  }

  .section-heading h2 {
    margin: 12px 0;
    font-size: 32px;
  }

  .section-heading p {
    color: var(--color-muted);
    line-height: 2;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    align-items: stretch;
  }

  .contact-info,
  .contact-visual {
    border-radius: 20px;
    padding: 35px;
    background: white;
  }

  .contact-info {
    border: 1px solid #e5eeeb;
  }

  .contact-item {
    display: flex;
    gap: 18px;
    margin-bottom: 30px;
  }

  .contact-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #e8f5f2;
    color: var(--color-primary);
    font-size: 25px;
  }

  .contact-item h3 {
    margin: 0 0 10px;
    font-size: 17px;
  }

  .contact-item p {
    margin: 0;
    color: var(--color-muted);
    line-height: 2.1;
    font-size: 14px;
  }

  .phone-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .phone-list a {
    color: var(--color-primary);
    font-weight: 600;
    direction: ltr;
  }

  .phone-list a:hover {
    color: var(--color-primary-dark);
  }

  .map-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding: 15px 18px;
    border-radius: 12px;
    background: var(--color-primary);
    color: white;
    font-weight: 600;
  }

  .map-link:hover {
    background: var(--color-primary-dark);
  }

  .contact-visual {
    display: grid;
    place-items: center;
    text-align: center;
    color: white;
    background:
      radial-gradient(circle at 80% 20%, #2b9990 0, transparent 35%),
      linear-gradient(135deg, #115e59, #0f766e);
    min-height: 350px;
  }

  .visual-content {
    max-width: 350px;
  }

  .visual-icon {
    display: inline-grid;
    place-items: center;
    width: 65px;
    height: 65px;
    border: 1px solid #ffffff55;
    border-radius: 20px;
    font-size: 30px;
  }

   .contact-logo-image {
    width: 100px;
    height: 100px;
    object-fit: contain;
    flex-shrink: 0;

    display: inline-grid;
    place-items: center;
  }

  .visual-content h3 {
    margin: 22px 0 8px;
    font-size: 23px;
  }

  .visual-content p {
    color: #d5eeea;
  }

  .visual-line {
    width: 50px;
    height: 2px;
    margin: 25px auto;
    background: #a7e3d9;
  }

  .supervision {
    font-size: 13px;
    color: #d5eeea;
  }

  @media (max-width: 750px) {
    .contact-section {
      padding: 65px 0;
    }

    .section-heading h2 {
      font-size: 26px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-info,
    .contact-visual {
      padding: 25px;
    }
  }
</style>
