
---
import { getCollection } from 'astro:content';


const base = import.meta.env.BASE_URL;

// دریافت مقالات و مرتب‌سازی بر اساس تاریخ اولین انتشار
const articles = (await getCollection('articles'))
  .sort((a, b) => {
    const dateA = a.data.publishDate
      ? new Date(a.data.publishDate).getTime()
      : 0;

    const dateB = b.data.publishDate
      ? new Date(b.data.publishDate).getTime()
      : 0;

    return dateB - dateA;
  })
  .slice(0, 3);

// اصلاح مسیر تصاویر برای GitHub Pages
const getImageUrl = (image?: string) => {
  if (!image) return '';

  if (image.startsWith('http://') || image.startsWith('https://')) {
    return image;
  }

  return `${base.replace(/\/?$/, '/')}${image.replace(/^\/+/, '')}`;
};
---

<section class="latest-articles" id="latest-articles">
  <div class="container">
    <div class="section-heading">
      <span class="section-label">دانش و آگاهی</span>
      <h2>آخرین مقالات</h2>
      <p>مطالب آموزشی و تخصصی در حوزه سلامت روان و مشاوره</p>
    </div>

    
    {articles.length > 0 ? (
    <div class="articles-grid">
        {articles.map((article) => (
        <article class="article-card">
            <a
            class="article-image"
            href={`${base.replace(/\/?$/, '/')}articles/${article.id}/`}
            >
            {article.data.image ? (
                <img
                src={getImageUrl(article.data.image)}
                alt={article.data.title}
                loading="lazy"
                />
            ) : (
                <div class="image-placeholder">مقاله آموزشی</div>
            )}
            </a>

            <div class="article-content">
            <h3>
                <a href={`${base.replace(/\/?$/, '/')}articles/${article.id}/`}>
                {article.data.title}
                </a>
            </h3>

            <p>{article.data.summary}</p>

            <a
                class="read-more"
                href={`${base.replace(/\/?$/, '/')}articles/${article.id}/`}
            >
                مطالعه مقاله
                <span>←</span>
            </a>
            </div>
        </article>
        ))}
    </div>
    ) : (
    <p class="empty-message">هنوز مقاله‌ای منتشر نشده است.</p>
    )}


    <div class="all-articles">
      <a href={`${base.replace(/\/?$/, '/')}articles/`}>
        مشاهده همه مقالات
      </a>
    </div>
  </div>
</section>

<style>
  .latest-articles {
    padding: 80px 0;
    background: #f7faf9;
  }

  .container {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 40px;
  }

  .section-label {
    color: #0d9488;
    font-size: 14px;
    font-weight: 600;
  }

  .section-heading h2 {
    color: #183b3a;
    font-size: 30px;
    margin: 12px 0;
  }

  .section-heading p {
    color: #64748b;
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .article-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e5eeec;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(15, 80, 75, 0.08);
  }

  .article-image {
    display: block;
    height: 210px;
    overflow: hidden;
    background: #e6f1ef;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .article-card:hover .article-image img {
    transform: scale(1.04);
  }

  .image-placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    color: #0d9488;
  }

  .article-content {
    padding: 22px;
  }

  .article-content h3 {
    font-size: 19px;
    margin: 0 0 12px;
    line-height: 1.8;
  }

  .article-content h3 a {
    color: #183b3a;
    text-decoration: none;
  }

  .article-content p {
    color: #64748b;
    font-size: 14px;
    line-height: 2;
    margin: 0 0 18px;
  }

  .read-more {
    color: #0d9488;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .read-more span {
    margin-right: 5px;
  }

  .all-articles {
    text-align: center;
    margin-top: 36px;
  }

  .all-articles a {
    display: inline-block;
    padding: 12px 26px;
    border: 1px solid #0d9488;
    border-radius: 8px;
    color: #0d9488;
    text-decoration: none;
    transition: 0.2s;
  }

  .all-articles a:hover {
    background: #0d9488;
    color: white;
  }

  .empty-message {
    text-align: center;
    color: #64748b;
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }

    .latest-articles {
      padding: 55px 0;
    }

    .section-heading h2 {
      font-size: 25px;
    }
  }
</style>
