
---
const services = [
  {
    number: '01',
    title: 'مشاوره پیش از ازدواج',
    description: 'شناخت معیارهای انتخاب همسر، خودشناسی و آمادگی برای تشکیل زندگی مشترک.',
  },
  {
    number: '02',
    title: 'خانواده و زوج‌درمانی',
    description: 'بهبود کیفیت روابط زوجین، مهارت‌های ارتباطی و حل تعارضات خانوادگی.',
  },
  {
    number: '03',
    title: 'مشاوره طلاق',
    description: 'حمایت روان‌شناختی پیش و پس از طلاق و کمک به کاهش آسیب‌های آن.',
  },
  {
    number: '04',
    title: 'مشاوره و درمان جنسی',
    description: 'ارزیابی و ارائه خدمات تخصصی در زمینه مسائل و اختلالات جنسی.',
  },
  {
    number: '05',
    title: 'مشاوره فردی',
    description: 'ارزیابی و کمک تخصصی در زمینه مشکلات روان‌شناختی و چالش‌های فردی.',
  },
  {
    number: '06',
    title: 'کودک، نوجوان و جوان',
    description: 'خدمات روان‌شناختی، بازی‌درمانی، فرزندپروری و مهارت‌های زندگی.',
  },
  {
    number: '07',
    title: 'مشاوره تحصیلی و شغلی',
    description: 'راهنمایی تحصیلی، استعدادیابی، برنامه‌ریزی و توسعه مهارت‌های شغلی.',
  },
  {
    number: '08',
    title: 'خدمات روان‌پزشکی',
    description: 'ارائه خدمات روان‌پزشکی و ارزیابی تخصصی با حضور روان‌پزشک.',
  },
  {
    number: '09',
    title: 'ارزیابی‌های تخصصی',
    description: 'آزمون‌های روان‌شناختی، گروه‌درمانی و نقشه‌برداری مغزی QEEG.',
  },
];
---

<section class="services-section" id="services">
  <div class="container">

    <div class="section-heading">
      <div>
        <span class="section-label">خدمات تخصصی مرکز همراه</span>
        <h2>در مسیر بهتر زندگی کردن،<br />همراه شما هستیم.</h2>
      </div>

      <a href="/services" class="all-services">
        مشاهده تمام خدمات
        <span>←</span>
      </a>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <a href="/services" class="service-card">
          <div class="card-top">
            <span class="service-number">{service.number}</span>
            <span class="service-arrow">↖</span>
          </div>

          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .services-section {
    padding: 100px 0;
    background: white;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 40px;
  }

  .section-label {
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 700;
  }

  .section-heading h2 {
    margin: 15px 0 0;
    color: #203b38;
    font-size: clamp(25px, 3vw, 35px);
    line-height: 1.8;
  }

  .all-services {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    padding-bottom: 10px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    min-height: 205px;
    padding: 25px;
    border: 1px solid #e9efed;
    border-radius: 15px;
    background: white;
    transition: 0.25s ease;
  }

  .service-card:hover {
    border-color: #b8dcd3;
    background: #f8fbfa;
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(39, 92, 80, 0.06);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .service-number {
    color: #91aaa4;
    font-size: 12px;
    font-weight: 700;
  }

  .service-arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #eaf4f1;
    color: var(--color-primary);
    font-size: 17px;
  }

  .service-card h3 {
    margin: 22px 0 8px;
    color: #29443f;
    font-size: 16px;
    font-weight: 700;
  }

  .service-card p {
    margin: 0;
    color: #82918e;
    font-size: 12px;
    line-height: 2.2;
  }

  @media (max-width: 850px) {
    .services-section {
      padding: 70px 0;
    }

    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 175px;
    }
  }
</style>
